# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mypass?schema=public"

# JWT secret — change to a long random string in production
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Server port
PORT=8082

# Host — use 0.0.0.0 to accept connections from your phone on the same WiFi
HOST=0.0.0.0
