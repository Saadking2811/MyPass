// MyPass database schema — PostgreSQL
// Managed by Prisma. Run `npm run db:push` after edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name") @db.VarChar(200)
  email        String   @unique @db.VarChar(200)
  phone        String   @default("") @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(200)
  avatarUrl    String   @default("") @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  boardingPasses BoardingPass[]
  checkIns       CheckIn[]

  @@map("users")
}

model Flight {
  id               String  @id @default(uuid())
  bookingReference String  @map("booking_reference") @db.VarChar(20)
  lastName         String  @map("last_name") @db.VarChar(100)
  passengerName    String  @map("passenger_name") @db.VarChar(200)
  flightNumber     String  @map("flight_number") @db.VarChar(20)
  airlineName      String  @default("Air Algérie") @map("airline_name") @db.VarChar(100)
  aircraftType     String  @default("Boeing 737-800") @map("aircraft_type") @db.VarChar(100)
  origin           String  @db.VarChar(10)
  originCity       String  @map("origin_city") @db.VarChar(100)
  destination      String  @db.VarChar(10)
  destinationCity  String  @map("destination_city") @db.VarChar(100)
  departureTime    String  @map("departure_time") @db.VarChar(50)
  arrivalTime      String  @map("arrival_time") @db.VarChar(50)
  duration         String  @db.VarChar(20)
  gate             String  @db.VarChar(10)
  terminal         String  @db.VarChar(10)
  seatClass        String  @default("Economy") @map("seat_class") @db.VarChar(30)
  checkInOpen      Boolean @default(true) @map("check_in_open")
  checkInStatus    String  @default("Not Checked-In") @map("check_in_status") @db.VarChar(30)
  price            Float   @default(0)
  currency         String  @default("DZD") @db.VarChar(10)

  seats    Seat[]
  checkIns CheckIn[]

  @@index([bookingReference, lastName])
  @@map("flights")
}

model Seat {
  id           Int     @id @default(autoincrement())
  flightId     String  @map("flight_id")
  seatCode     String  @map("seat_code") @db.VarChar(10)
  row          Int
  column       String  @map("col") @db.VarChar(5)
  premium      Boolean @default(false)
  occupied     Boolean @default(false)
  extraLegroom Boolean @default(false) @map("extra_legroom")
  window       Boolean @default(false)
  aisle        Boolean @default(false)
  price        Float   @default(0)

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@map("seats")
}

model BoardingPass {
  id               String   @id @default(uuid())
  userId           String?  @map("user_id")
  bookingReference String   @map("booking_reference") @db.VarChar(20)
  passengerName    String   @map("passenger_name") @db.VarChar(200)
  flightNumber     String   @map("flight_number") @db.VarChar(20)
  airlineName      String   @default("Air Algérie") @map("airline_name") @db.VarChar(100)
  origin           String   @db.VarChar(10)
  originCity       String   @map("origin_city") @db.VarChar(100)
  destination      String   @db.VarChar(10)
  destinationCity  String   @map("destination_city") @db.VarChar(100)
  departureTime    String   @map("departure_time") @db.VarChar(50)
  arrivalTime      String   @map("arrival_time") @db.VarChar(50)
  gate             String   @db.VarChar(10)
  terminal         String   @db.VarChar(10)
  seat             String   @db.VarChar(10)
  seatClass        String   @map("seat_class") @db.VarChar(30)
  boardingGroup    String   @map("boarding_group") @db.VarChar(20)
  sequence         String   @db.VarChar(10)
  qrPayload        String   @map("qr_payload") @db.VarChar(500)
  issuedAt         DateTime @default(now()) @map("issued_at")
  baggageInfo      String   @default("") @map("baggage_info") @db.VarChar(200)
  status           String   @default("Active") @db.VarChar(20)
  passportNumber   String   @default("") @map("passport_number") @db.VarChar(20)
  passportName     String   @default("") @map("passport_name") @db.VarChar(200)
  nationality      String   @default("") @db.VarChar(10)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkIn CheckIn?

  @@index([userId])
  @@map("boarding_passes")
}

model CheckIn {
  id                  String   @id @default(uuid())
  userId              String?  @map("user_id")
  flightId            String   @map("flight_id")
  boardingPassId      String   @unique @map("boarding_pass_id")
  passportNumber      String   @map("passport_number") @db.VarChar(20)
  passportName        String   @map("passport_name") @db.VarChar(200)
  passportNationality String   @map("passport_nationality") @db.VarChar(10)
  passportDob         String   @map("passport_dob") @db.VarChar(20)
  passportExpiry      String   @map("passport_expiry") @db.VarChar(20)
  passportGender      String   @map("passport_gender") @db.VarChar(5)
  selectedSeat        String   @map("selected_seat") @db.VarChar(10)
  checkedBags         Int      @default(0) @map("checked_bags")
  carryOnBags         Int      @default(1) @map("carry_on_bags")
  oversizedBags       Int      @default(0) @map("oversized_bags")
  dietaryPreference   String   @default("Standard") @map("dietary_preference") @db.VarChar(50)
  needsAssistance     Boolean  @default(false) @map("needs_assistance")
  travelingWithInfant Boolean  @default(false) @map("traveling_with_infant")
  travelingWithPet    Boolean  @default(false) @map("traveling_with_pet")
  notes               String   @default("") @db.Text
  checkedInAt         DateTime @default(now()) @map("checked_in_at")

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  flight       Flight       @relation(fields: [flightId], references: [id])
  boardingPass BoardingPass @relation(fields: [boardingPassId], references: [id])

  @@index([userId])
  @@index([flightId])
  @@map("check_ins")
}
