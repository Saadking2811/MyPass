<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Matches the logo PNG: white circle inside the safe zone + dark-green
         top-down airplane silhouette, slightly tilted upward to the right. -->

    <!-- White circle (safe zone is 66x66 centered at 54,54) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-33,0 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0" />

    <!-- Dark green airplane (top-down view, rotated -22°) -->
    <group
        android:translateX="54"
        android:translateY="54"
        android:rotation="-22">

        <!-- Fuselage with rounded nose -->
        <path
            android:fillColor="#004D2F"
            android:pathData="M-3,-21 Q-3,-23 0,-23 Q3,-23 3,-21 L3,13 L8,17 L8,20 L-8,20 L-8,17 L-3,13 Z" />

        <!-- Main wings — swept-back trapezoids -->
        <path
            android:fillColor="#004D2F"
            android:pathData="M-3,-3 L-25,5 L-25,8 L-3,4 Z" />
        <path
            android:fillColor="#004D2F"
            android:pathData="M3,-3 L25,5 L25,8 L3,4 Z" />

        <!-- Horizontal tail stabilizers -->
        <path
            android:fillColor="#004D2F"
            android:pathData="M-3,13 L-11,16 L-11,18 L-3,17 Z" />
        <path
            android:fillColor="#004D2F"
            android:pathData="M3,13 L11,16 L11,18 L3,17 Z" />
    </group>
</vector>
